# Copy to .env (local) or set in your hosting provider. Never commit real values.
APP_ENV=development                # development | staging | production
API_URL=                           # public API URL used by the web config (blank = same origin)
DATABASE_URL=sqlite:///data/gridintel.db
# DATABASE_URL=postgresql://gridintel:gridintel@localhost:5432/gridintel
REDIS_URL=                         # e.g. redis://localhost:6379/0 (blank = in-memory)
JWT_SECRET=                        # required in production, >= 32 chars
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=*                     # production: https://your-web.vercel.app
DATA_ROOT=data                     # must contain raw/ with the private workbooks
MODEL_PATH=models
REPORTS_DIR=reports
ADMIN_USERNAME=
ADMIN_PASSWORD=
DEMO_USERS_ENABLED=true            # operator / engineer / viewer : hvpnl2026
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=20
ALERT_MIN_RISK=56
REPLAY_BASE_INTERVAL_SEC=3.0
PRIMARY_SUBSTATION=220-sec-46
LOG_LEVEL=INFO
TRAIN_ON_START=true               # false on small instances (training needs ~1 GB RAM)
